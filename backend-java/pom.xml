<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 父 POM：统一管理所有依赖的版本号，
         下面引依赖时就不用再写 <version> 了 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.campus</groupId>
    <artifactId>campus-errand-backend</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>campus-errand-backend</name>

    <!-- 注意：这里不是 war 而是 jar。
         Spring Boot 内嵌 Tomcat，java -jar 直接启动，不用另外装 Tomcat 部署 -->
    <packaging>jar</packaging>

    <properties>
        <java.version>23</java.version>
        <!-- 组长指定版本：Spring Boot 3.5.0 默认内嵌 Tomcat 10.1.x，
             这里用 tomcat.version 属性覆盖为 11.0.9 -->
        <tomcat.version>11.0.9</tomcat.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- Web：提供 @RestController、内嵌 Tomcat、Jackson（自动把对象转 JSON） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JDBC：提供 JdbcTemplate 和数据库连接池（HikariCP）。
             注意不是 spring-boot-starter-data-jpa —— 我们自己写 SQL，不用 JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- SQLite 驱动。对应 Javatest 模板里的 mysql-connector-j -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.1.0</version>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- 打出可执行 jar，并提供 mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
